{
  "name": "reconai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run lint && vite build",
    "lint": "tsc --noEmit --jsx react-jsx --module ES2022 --moduleResolution Bundler --target ES2022 --lib DOM,DOM.Iterable,ES2022 --strict --types vitest/globals src/main.tsx src/App.tsx src/api/health.ts src/App.test.tsx src/api/health.test.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "devDependencies": {}
}
